{
  "name": "jako-karaoke-site",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "prepare": "prek install",
    "spec:export": "cargo run --manifest-path backend/Cargo.toml --bin export-spec > openapi.json",
    "api:gen": "pnpm spec:export && pnpm --filter jako-karaoke-frontend api:gen"
  },
  "devDependencies": {
    "@j178/prek": "^0.4.13",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.13"
  }
}
